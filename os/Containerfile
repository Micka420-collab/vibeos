# =============================================================================
# VibeOS — bootc/OSTree image definition (v0.1.0-dev)
#
# Base    : Fedora Kinoite 44 (KDE Plasma 6), bootc-native OCI image,
#           pinned by DIGEST (supply-chain: never a mutable tag).
# Target  : ghcr.io/micka420-collab/vibeos
#           (keep in sync with .github/workflows/build-os.yml)
# Arch    : linux/amd64 AND linux/arm64 (multi-arch manifest). The NVIDIA
#           layer below applies to amd64 only. See docs/HARDWARE.md for the
#           reference machines.
#
# Build context is the REPOSITORY ROOT (not os/), because the image pulls
# files from os/, memory/ and security/:
#
#     podman build -t ghcr.io/micka420-collab/vibeos:dev -f os/Containerfile .
#     podman build --arch arm64 -t ghcr.io/micka420-collab/vibeos:dev-arm64 -f os/Containerfile .
#
# OSTree layout rules enforced throughout this file:
#   * /usr        -> image content (immutable at runtime). Everything we ship
#                    MUST land under /usr (or /etc for defaults).
#   * /etc        -> image defaults, 3-way merged with local changes on update.
#   * /var        -> machine state, created at deploy time. Anything written
#                    to /var during the build is dead weight and is scrubbed
#                    before `bootc container lint`.
#   * /usr/local and /opt are symlinks into /var on OSTree systems: NEVER
#                    install anything there.
#
# See docs/BUILD.md (French) for the full build / ISO / publish workflow.
# =============================================================================

# Global build arg: ship the VibeOS-for-Zed governance extension (ADR-015)?
# OFF by default — the extension is NOT shipped until the live E2E is validated
# (ADR-015 §6, BLOCKERS.md). Declared before the first FROM so it can select the
# conditional-copy stage below. Enable with `--build-arg WITH_ZED_AGENT=1`.
ARG WITH_ZED_AGENT=0

# -----------------------------------------------------------------------------
# PHASE 2: build vibed from source (multi-stage). The vibed.service unit shipped
# in os/rootfs is guarded by ConditionPathExists=/usr/bin/vibed; installing the
# binary below (COPY --from=vibed-builder in layer 7) brings the daemon online
# at boot. vibed/Cargo.lock is committed, so `--locked` builds are reproducible
# (verified with Fedora's cargo). The stage is discarded from the final image;
# only the stripped binary is copied in.
# -----------------------------------------------------------------------------
FROM registry.fedoraproject.org/fedora:44 AS vibed-builder
RUN dnf -y install cargo && dnf clean all
COPY vibed/ /src/vibed/
WORKDIR /src/vibed
# Builds both binaries of the crate: vibed (daemon) and vibectl (operator CLI).
RUN cargo build --release --locked \
 && strip target/release/vibed target/release/vibectl

# -----------------------------------------------------------------------------
# PHASE 2: build Quickshell from source (multi-stage).
#
# NOTE (2026-07-15): this stage is now REDUNDANT. It exists because Fedora 42
# packaged no quickshell anywhere; the comment even predicted "the official
# Fedora package starts at f44". We are now ON f44, and `quickshell-0.2.1` —
# the exact version built here — IS packaged for BOTH x86_64 and aarch64
# (verified 2026-07-15). Dropping this stage in favour of `dnf install
# quickshell` would delete ~40 lines AND make the HUD receive Fedora security
# updates instead of riding a frozen tarball.
#
# It is deliberately NOT dropped in this commit: a security rebase must not
# also swap the provenance of a shipped component — that is a second change
# with its own failure modes, and bundling them would make a bisect useless.
# Follow-up tracked separately.
#
# The HUD runtime is compiled here following the official Fedora quickshell.spec recipe
# (BuildRequires + cmake flags), then copied into /usr as immutable image
# content. Supply chain: version pinned + sha256 verified before extraction.
# X11=OFF: the image is Wayland-only (Kinoite heritage, docs/DESKTOP.md §4).
# CAVEAT (Qt private ABI): quickshell uses Qt6 PRIVATE APIs; the binary only
# loads against the exact Qt patch version it was built with (versioned symbol
# Qt_6.x.y_PRIVATE_API). The `quickshell --version` check in the final image
# (layer 7) fails the build loudly on any mismatch with the pinned base —
# bump the base digest and this stage rebuilds against the matching Qt.
# -----------------------------------------------------------------------------
FROM registry.fedoraproject.org/fedora:44 AS quickshell-builder
ARG QUICKSHELL_VERSION=0.2.1
ARG QUICKSHELL_SHA256=337bab5d4badb92e51d01ac1cfbeaeb784478bad82f3c8297fd7be42a6995af2
# Dependency list transcribed 1:1 from the official Fedora quickshell.spec
# (rawhide, 0.2.1): rich deps (cmake()/pkgconfig()) let dnf resolve the right
# Fedora 44 package names instead of hardcoding them.
RUN dnf -y install --setopt=install_weak_deps=False \
        cmake ninja-build gcc-c++ curl tar gzip \
        'cmake(Qt6Core)' 'cmake(Qt6Qml)' \
        'cmake(Qt6CorePrivate)' 'cmake(Qt6QuickPrivate)' \
        'cmake(Qt6ShaderTools)' 'cmake(Qt6WaylandClient)' \
        'pkgconfig(CLI11)' 'pkgconfig(glib-2.0)' 'pkgconfig(gbm)' \
        'pkgconfig(jemalloc)' 'pkgconfig(libdrm)' 'pkgconfig(libpipewire-0.3)' \
        'pkgconfig(pam)' 'pkgconfig(polkit-agent-1)' \
        'pkgconfig(wayland-client)' 'pkgconfig(wayland-protocols)' \
        spirv-tools \
    && dnf clean all
RUN set -eu; \
    mkdir -p /src; \
    curl -fsSL -o /tmp/quickshell.tar.gz \
        "https://github.com/quickshell-mirror/quickshell/archive/refs/tags/v${QUICKSHELL_VERSION}.tar.gz"; \
    echo "${QUICKSHELL_SHA256}  /tmp/quickshell.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/quickshell.tar.gz -C /src --strip-components=1; \
    cmake -GNinja -S /src -B /build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DDISTRIBUTOR="VibeOS" \
        -DDISTRIBUTOR_DEBUGINFO_AVAILABLE=NO \
        -DINSTALL_QML_PREFIX=lib64/qt6/qml \
        -DCRASH_REPORTER=OFF \
        -DX11=OFF; \
    cmake --build /build; \
    DESTDIR=/out cmake --install /build

# -----------------------------------------------------------------------------
# PHASE 2ter: build the VibeOS-for-Zed governance extension (ADR-014/015).
# The extension patches the Claude Code ACP adapter's `canUseTool` to route the
# hosted agent's permissions through vibed's policy engine. It is bundled to a
# SINGLE self-contained ESM file so ONLY that file ships — never node_modules,
# the ~148 transitive npm packages, the TS sources, or the dev tooling.
#
# Supply chain (ADR-015, same discipline as the CLI installs above):
#   * committed lockfile (package-lock.json): exact transitive versions +
#     SHA-512 integrity per package, pinned to the upstream 0.58.x adapter;
#   * `npm ci --ignore-scripts`: reproducible from the lock (fails if it drifts
#     from package.json), NO lifecycle scripts (postinstall &c — a classic
#     exfiltration vector); esbuild's platform binary comes from an optional
#     dependency package, so no rebuild exception is needed;
#   * esbuild bundles src/ -> dist/vibeos-claude-acp.mjs; the build then boots
#     that bundle headless and asserts it answers ACP `initialize` (the same
#     "prove it runs" gate the shipped CLIs get) before it can be copied.
# `npm audit --omit=dev` on the shipped chain = 0 vulnerabilities (2026-07-13);
# the dev-only advisories (esbuild dev-server, vitest) never enter the image.
#
# This stage (and its ~148-package npm install) is built ONLY when
# WITH_ZED_AGENT=1 — the selector below keeps it out of the default graph.
# -----------------------------------------------------------------------------
FROM registry.fedoraproject.org/fedora:44 AS zed-agent-builder
# Voir la note nodejs24 de la couche 1a : f44 n'a plus de metapaquet `nodejs`.
RUN dnf -y install nodejs24 nodejs24-npm && dnf clean all
WORKDIR /src/ext
# Copy only the build inputs — never a pre-existing node_modules/ or dist/ from
# the context (npm ci rebuilds from the lockfile; the bundle is regenerated).
COPY zed/vibeos-claude-acp/package.json zed/vibeos-claude-acp/package-lock.json zed/vibeos-claude-acp/tsconfig.json ./
COPY zed/vibeos-claude-acp/src/ ./src/
COPY zed/vibeos-claude-acp/scripts/ ./scripts/
RUN npm ci --ignore-scripts \
 && npm run bundle \
 && node scripts/smoke-acp.mjs dist/vibeos-claude-acp.mjs \
 && mkdir -p /out/zed-agent \
 && cp dist/vibeos-claude-acp.mjs /out/zed-agent/

# Conditional-copy selector. buildah/podman only builds the stages reachable
# from the final image, so with WITH_ZED_AGENT=0 the builder above is skipped
# entirely (no Node, no npm install). The disabled variant ships a self-
# documenting marker instead of the bundle.
FROM registry.fedoraproject.org/fedora:44 AS zed-agent-0
RUN mkdir -p /out/zed-agent \
 && printf 'The VibeOS-for-Zed extension is NOT shipped in this image.\nRebuild with --build-arg WITH_ZED_AGENT=1 once the live E2E is validated\n(ADR-015 §6, BLOCKERS.md).\n' > /out/zed-agent/NOT-INSTALLED.txt

FROM zed-agent-builder AS zed-agent-1

FROM zed-agent-${WITH_ZED_AGENT} AS zed-agent-selected

# Digest pin of quay.io/fedora/fedora-kinoite:44 (manifest list, amd64+arm64).
# Tag kept as a comment for humans; bump the digest deliberately, never float.
#
# ⚠️ CE PIN CASSE PÉRIODIQUEMENT, et c'est structurel — pas un accident.
#
# Constaté le 2026-07-16 PUIS le 2026-07-17 (deux purges quotidiennes CONSECUTIVES) :
# le digest précédent (a95907b4…, puis 2d24c434…) a cessé de résoudre
# — « manifest unknown » — quelques heures après avoir servi à un build vert.
# Fedora avait republié `:44` à 01:00 UTC, et quay a PURGÉ l'index précédent.
# Tous les builds ont cassé d'un coup, y compris main.
#
# Pourquoi ça n'arrivait pas avant : la base était f42, EOL depuis le
# 2026-05-27 — donc plus jamais reconstruite, donc un digest stable pour
# toujours. Le pin « tenait » parce que l'amont était MORT. Passer sur une base
# VIVANTE (f44, rebâtie quasi quotidiennement) rend le pin fragile : c'est le
# prix, non anticipé, de la sortie de l'EOL.
#
# Deux exigences se contredisent ici, et il faut le dire plutôt que le subir :
#   * la posture supply-chain veut un digest (reproductible, non falsifiable) ;
#   * l'amont purge ses vieux index, donc tout digest a une durée de vie courte.
#
# Ce qu'on NE fait pas : repasser sur le tag `:44` flottant. Ça rendrait chaque
# build non reproductible et laisserait entrer n'importe quel contenu republié
# sans revue — exactement ce que le pin existe pour empêcher.
#
# Ce qu'il faudra décider (arbitrage opérateur, non tranché ici) :
#   a) bumper le digest à la main quand ça casse — honnête, mais c'est une
#      astreinte quasi quotidienne, et ça casse TOUJOURS au pire moment ;
#   b) mettre à jour le digest automatiquement (Renovate/Dependabot) — la CI
#      propose une PR, un humain la revoit : le pin reste, l'astreinte part ;
#   c) MIROITER la base dans notre propre registre (ghcr) et épingler celui-ci —
#      on maîtrise la rétention, personne ne purge sous nos pieds.
#
# Pour re-résoudre le digest courant :
#   skopeo inspect --format '{{.Digest}}' docker://quay.io/fedora/fedora-kinoite:44
FROM quay.io/fedora/fedora-kinoite:44@sha256:3b45538879b7817c9f4e9b196e99a8b80d0e9982c94dcd0f1997af5cf7ed9436

# Version de l'image, injectée par la CI depuis le tag (`v0.2.1-dev` -> `0.2.1-dev`).
#
# Elle était CODÉE EN DUR à `0.1.0-dev`, et rien ne l'écrasait au build : l'action
# buildah-build n'injecte aucun label OCI et le workflow ne lui passait pas
# `labels:`. Résultat, l'image poussée sous le TAG `:0.2.1-dev` annonçait
# `org.opencontainers.image.version="0.1.0-dev"` — un mensonge dans les
# métadonnées livrées, que lisent les outils et les registres. Le `version` du
# workflow ne servait qu'à nommer le tag, jamais à labelliser l'image.
#
# Défaut `0.0.0-dev` pour un build local, délibérément : mieux vaut une version
# manifestement fausse qu'un numéro PLAUSIBLE mais périmé. C'est précisément ce
# qui s'est produit — `0.1.0-dev` avait l'air juste, donc personne ne l'a
# regardé pendant que les tags passaient à 0.2.x.
ARG IMAGE_VERSION=0.0.0-dev

LABEL org.opencontainers.image.title="VibeOS" \
      org.opencontainers.image.description="AI-native, security-first, immutable Linux distribution for vibecoding" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.source="https://github.com/Micka420-collab/vibeos" \
      org.opencontainers.image.base.name="quay.io/fedora/fedora-kinoite:44@sha256:3b45538879b7817c9f4e9b196e99a8b80d0e9982c94dcd0f1997af5cf7ed9436"

# TARGETARCH is auto-populated by podman/buildah when building with --platform
# (amd64 | arm64). Defaulted to amd64 for plain single-arch local builds.
ARG TARGETARCH=amd64
# Set to 0 to skip the proprietary NVIDIA driver layer (amd64 only anyway).
ARG NVIDIA_ENABLED=1

# =============================================================================
# 1. RPM layers (dnf)
#    Grouped by intent; keep os/packages.txt in strict sync with these lists.
#    install_weak_deps=False keeps the image lean and the dependency graph
#    deterministic.
# =============================================================================

# --- 1a. Core development toolchain ------------------------------------------
# nodejs24 / nodejs24-npm, et NON `nodejs` / `npm` : f44 a retiré les
# métapaquets non versionnés — il n'existe plus que des streams (nodejs20 /
# nodejs22 / nodejs24), et `dnf install nodejs npm` échoue désormais.
#
# Stream 24 et non 22, délibérément : node 22 meurt (avril 2027) AVANT la base
# f44 (juin 2027). Shipper un runtime qui meurt avant la distro qui le porte,
# c'est refaire en petit le bug qui a motivé ce rebase.
# Vérifié sur les dépôts f44 : nodejs24-24.13.1, nodejs24-npm-11.8.0.
RUN dnf -y install --setopt=install_weak_deps=False \
        git \
        gcc \
        make \
        cmake \
        python3 \
        python3-pip \
        nodejs24 \
        nodejs24-npm \
    && dnf clean all

# --- 1b. Terminal quality-of-life + plumbing ----------------------------------
# socat: MCP bridge between agent CLIs (stdio) and vibed's unix socket
#        /run/vibed/mcp.sock — documented in agent/README.md and vibed/README.md.
# zstd : required to extract the official ollama .tar.zst release archives
#        (layer 4 below).
RUN dnf -y install --setopt=install_weak_deps=False \
        ripgrep \
        fd-find \
        fzf \
        tmux \
        jq \
        htop \
        fastfetch \
        distrobox \
        socat \
        zstd \
    && dnf clean all

# --- 1c. Virtualization / test tooling (kept deliberately minimal) -----------
# Only guest-side agents so VibeOS behaves well when IT is the VM under test.
# Host-side virt (libvirt/qemu) is left to distrobox or a later phase.
RUN dnf -y install --setopt=install_weak_deps=False \
        qemu-guest-agent \
        virt-what \
    && dnf clean all

# --- 1d. Vibecoding terminal stack (Fedora repos) ----------------------------
# The curated default terminal experience (see docs/ECOSYSTEM.md). First-run
# configs ship in /etc/skel (see os/rootfs/etc/skel). These packages are all in
# the Fedora repositories; COPR/binary tools (ghostty, yazi, lazygit, atuin,
# mise) are layered separately below. The skel configs guard every tool behind
# `command -v`, so anything not yet installed degrades gracefully.
#   fish     interactive shell (bash stays /bin/sh)
#   neovim   terminal editor, base of the "VibeVim" preset
#   zoxide   smart directory jumping
#   bat      cat with syntax highlighting (also fzf/yazi previewer)
#   eza      modern ls with per-file git status
#   btop     TUI system monitor with GPU support (ollama inference)
#   atuin    shell history with rich search (audit trail of agent commands)
#   *-fonts  JetBrains Mono + Fira Code — the terminal/editor default fonts
#            referenced by /etc/skel/.config/ghostty/config
# NOTE: starship, zellij, ghostty, yazi, lazygit are NOT in the Fedora repos;
# they are layered from COPR below (layer 1e); mise from its vendor repo (1f).
RUN dnf -y install --setopt=install_weak_deps=False \
        fish \
        neovim \
        zoxide \
        bat \
        eza \
        btop \
        atuin \
        jetbrains-mono-fonts \
        fira-code-fonts \
    && dnf clean all

# --- 1d-bis. Security toolkit (Fedora repos + RPM Fusion) --------------------
# VibeOS is security-first: a professional pentest/DFIR toolkit ships in the
# image, the way Kali/Parrot/BlackArch do. Every package here is a SIGNED
# Fedora / RPM Fusion RPM (clean supply chain for an immutable OS); the wider
# landscape (Go/pip tools, C2 frameworks, SDR GUIs) is curated in
# docs/SECURITY-TOOLKIT.md and installed per-user (pipx/go) or via distrobox.
#
# GOVERNANCE — read docs/SECURITY-TOOLKIT.md §"Gouvernance" before extending:
# these tools are available to the HUMAN operator in the shell. AI agents do
# NOT get to run them freely: any future agent-invocation path goes through
# vibed's policy engine, where active-against-a-target tools are T2 and
# destructive ones T3 — both requiring out-of-band HUMAN APPROVAL (the Phase 4
# approval flow). The T0 tool `sectools.list` lets an agent DISCOVER the
# toolkit (read-only) without executing anything. Authorized-use only: the
# operator's own systems, sanctioned engagements, CTF, and research.
# Keep os/security-tools.txt in strict sync with this list.
RUN dnf -y install --setopt=install_weak_deps=False \
        nmap \
        nmap-ncat \
        masscan \
        tcpdump \
        wireshark-cli \
        hping3 \
        ngrep \
        tcpreplay \
        arp-scan \
        dnsenum \
        bind-utils \
        whois \
        macchanger \
        proxychains-ng \
        tor \
        dsniff \
        ettercap \
        hydra \
        john \
        hashcat \
        medusa \
        ncrack \
        aircrack-ng \
        reaver \
        pixiewps \
        hcxtools \
        kismet \
        whatweb \
        gobuster \
        ffuf \
        radare2 \
        rizin \
        binwalk \
        yara \
        gdb \
        strace \
        ltrace \
        patchelf \
        upx \
        checksec \
        python3-pwntools \
        sleuthkit \
        foremost \
        testdisk \
        chntpw \
        steghide \
        perl-Image-ExifTool \
        python3-impacket \
        clamav \
        rkhunter \
        lynis \
        chkrootkit \
        aide \
        openscap \
        openscap-scanner \
        scap-security-guide \
        suricata \
        age \
    && dnf clean all \
    # /run is a tmpfs recreated every boot: don't bake service runtime dirs
    # into the image (bootc lint `nonempty-run-tmp`). suricata/tor recreate
    # them at boot via their own tmpfiles.d.
    && rm -rf /run/suricata /run/tor

# --- 1d-ter. Touseau SaaS + ecommerce (Fedora repos) — OUTILS, PAS SERVEURS --
# Seconde trousse gouvernée, même modèle que la cybersécurité ci-dessus
# (docs/DECISIONS.md ADR-020) : des OUTILS disponibles dans le shell, dont
# l'invocation par l'IA passera par le tiering vibed (dev local = T1 ;
# déploiement/dépense = T2/T3).
#
# CE QUI EST ICI vs CE QUI N'Y EST PAS — distinction décidée par ADR-020 après
# revue adversariale : uniquement des OUTILS PASSIFS (ils tournent, sortent, ne
# laissent rien). Les SERVEURS (postgresql-server, valkey-server, un
# reverse-proxy, un exporter) ne sont PAS gravés dans /usr : ce sont des
# conteneurs par PROJET, lancés via podman + podman-compose (déjà natifs), à
# partir des modèles /usr/share/vibeos/saas/. D'où : le CLIENT `postgresql`
# (psql), pas `postgresql-server` (vérifié : le client ne tire pas le serveur).
#
# GOUVERNANCE : `npm install`/`pip install` sont le vecteur supply-chain M4
# (hooks postinstall = RCE réseau) et tournent aujourd'hui dans le shell NON
# gouverné (écart Bash natif, invariant n°1). L'IA ne déploie PAS en prod sans
# la couche gouvernée à venir (deploy.* + allowlist + isolation credentials).
#
# Keep os/saas-tools.txt in strict sync with this list.
RUN dnf -y install --setopt=install_weak_deps=False \
        postgresql \
        sqlite \
        valkey-compat-redis \
        mkcert \
        podman-compose \
        uv \
        ruff \
        python3-mypy \
        httpd-tools \
        perf \
        sysstat \
        bpftrace \
        bcc-tools \
        gh \
    && dnf clean all

# --- 1e. Vibecoding terminal stack (COPR) ------------------------------------
# Tools not packaged in Fedora, from well-maintained COPRs. All five verified
# to ship fedora-44 chroots for BOTH x86_64 and aarch64 (2026-07-15, before the
# f42->f44 rebase — a COPR without an f44 build would fail the image silently
# at install time): starship (atim), zellij (varlad), lazygit (atim), ghostty
# (scottames), yazi (lihaohong). dnf5-plugins provides the `dnf copr`
# subcommand. SUPPLY CHAIN (audit decision): the COPR repos are enabled only
# for the install below and DISABLED before the layer ends — a deployed
# system never trusts a COPR repo at runtime. Updates still flow through
# image rebuilds (this step re-enables, installs current versions,
# re-disables); the exact shipped versions are recorded in the NEVRA
# manifest (/usr/share/vibeos/packages-nevra.txt, layer 8).
# /etc/skel configures fish -> starship, Ghostty, the Zellij "vibe" layout
# and yazi.
RUN dnf -y install dnf5-plugins \
    && dnf -y copr enable atim/starship \
    && dnf -y copr enable varlad/zellij \
    && dnf -y copr enable atim/lazygit \
    && dnf -y copr enable scottames/ghostty \
    && dnf -y copr enable lihaohong/yazi \
    && dnf -y install --setopt=install_weak_deps=False \
        starship \
        zellij \
        lazygit \
        ghostty \
        yazi \
    && dnf -y copr disable atim/starship \
    && dnf -y copr disable varlad/zellij \
    && dnf -y copr disable atim/lazygit \
    && dnf -y copr disable scottames/ghostty \
    && dnf -y copr disable lihaohong/yazi \
    && dnf clean all

# --- 1e-bis. Signing keys of third-party repos (PINNED, shipped by this repo) --
# Imported from DISK, never fetched at build time. `rpm --import <url>` trusts
# whatever key that URL serves, and `dnf -y` silently accepts a key advertised by
# an upstream .repo — after which gpgcheck=1 faithfully validates against the
# attacker's key. Pinning moves that trust into a reviewable diff.
# Provenance, fingerprints and the verification actually performed (each key was
# checked against the real repomd.xml.asc it is meant to sign): os/keys/README.md.
# Copied into the standard location so the .repo files below — and any later
# `dnf update` inside a rebuild — resolve gpgkey= to a LOCAL path, never a URL.
COPY os/keys/RPM-GPG-KEY-vscodium os/keys/RPM-GPG-KEY-mise /etc/pki/rpm-gpg/

# --- 1f. mise (vendor rpm repo) ----------------------------------------------
# Runtime/toolchain manager (Node, Python, Go...) installed per-user into $HOME
# — nothing written to /usr at runtime, ideal for an immutable OS.
# The .repo is written HERE rather than pulled with `config-manager addrepo
# --from-repofile=https://...`: that fetched a repo definition whose gpgkey= was a
# URL, so the build imported a key it had never seen. Two hardenings over the
# upstream file: gpgkey points at the pinned key on disk, and repo_gpgcheck=1 is
# enabled (upstream ships repomd.xml.asc but does not ask dnf to check it).
# gpgcheck stays enforced end-to-end for future rebuilds.
#
# enabled=0 + --enablerepo pour l'install : MÊME discipline que les COPR
# ci-dessus (« activé pour l'install, DÉSACTIVÉ avant la fin de la couche — un
# système déployé ne fait jamais confiance à un dépôt tiers à l'exécution »).
#
# Ce n'est pas que de l'hygiène, c'est un BUG CORRIGÉ : laissé `enabled=1` avec
# `gpgkey=file://`, ce dépôt CASSE LA CONSTRUCTION DE L'ISO. bootc-image-builder
# fait un depsolve en lisant les .repo de l'image, mais depuis SON PROPRE
# conteneur — où /etc/pki/rpm-gpg/… n'existe pas. dnf résout alors le file://
# chez lui et meurt : « Curl error (37): Could not read a file:// file … cannot
# depsolve ». Un dépôt DÉSACTIVÉ n'est jamais résolu : le problème disparaît, et
# l'image déployée est plus stricte qu'avant.
#
# Piège à connaître : ce chemin n'est PAS couvert par les PR. Sur une PR,
# build-os ne fait qu'un build de vérification amd64 — le job ISO ne tourne qu'en
# release (tag v*). Une régression d'ISO passe donc la CI au vert et ne sort
# qu'au tag (c'est exactement ce qui est arrivé le 2026-07-15).
RUN set -eux \
    && rpmkeys --import /etc/pki/rpm-gpg/RPM-GPG-KEY-mise \
    && printf '%s\n' \
        '[mise-repo]' \
        'name=mise' \
        'baseurl=https://mise.jdx.dev/rpm' \
        'enabled=0' \
        'gpgcheck=1' \
        'repo_gpgcheck=1' \
        'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-mise' \
        'metadata_expire=1h' \
        > /etc/yum.repos.d/mise.repo \
    && dnf -y --enablerepo=mise-repo install --setopt=install_weak_deps=False mise \
    && dnf clean all

# --- 1g. Desktop chrome runtime (Phase 2 — HUD + Global Theme) ----------------
# kvantum : Qt widget style engine required by the VibeOS Dark Global Theme
#           (widgetStyle=kvantum in org.vibeos.dark/contents/defaults, which
#           documents the graceful Breeze fallback if it were missing).
# jemalloc / qt6-qtsvg : runtime dependencies of the quickshell binary built
#           in the quickshell-builder stage (Requires: of the Fedora spec;
#           qt6-qtsvg is already in the Kinoite base — kept explicit).
# plymouth-plugin-script : REQUIRED by the VibeOS boot theme, which declares
#           ModuleName=script (desktop/plymouth/vibeos/vibeos.plymouth) — that
#           module lives in this subpackage, and Fedora's default boot theme does
#           not use it, so nothing else pulls it in. Without it the theme copied
#           at layer 8 could never render: the day Phase 5 flips the default,
#           plymouth would fall back instead. Installing it does NOT activate
#           anything (activation = plymouth-set-default-theme + initramfs
#           regeneration, still Phase 5); it only removes a trap laid for that day.
# plymouth-plugin-label : the theme's Image.Text() (LUKS prompt, boot messages)
#           needs a label renderer. Fedora's default theme already pulls this in
#           — kept explicit for the same reason as qt6-qtsvg: the boot splash must
#           not depend on what the base image happens to ship today.
RUN dnf -y install --setopt=install_weak_deps=False \
        kvantum \
        jemalloc \
        qt6-qtsvg \
        plymouth-plugin-script \
        plymouth-plugin-label \
    && dnf clean all

# --- 1h. Navigateur gouverné : chromium-headless (substrat de browser.*, ADR-022) --
# `headless_shell`, le binaire Chromium MINIMAL — construit sans alsa/cups/dbus/
# gconf/gio/kerberos/pulseaudio/udev (surface d'attaque réduite). Packagé par Fedora 44
# pour x86_64 ET aarch64 (multi-arch préservé — c'est la disparition du showstopper
# arm64 d'ADR-017 ; vérifié 2026-07-21 : chromium-headless-150.0.7871.124-1.fc44 présent
# sur les DEUX arches en STABLE, pas updates-testing). Le binaire vit à
# /usr/lib64/chromium-browser/headless_shell (chromium-headless tire chromium-common).
#
# GOUVERNANCE (ADR-022) : chromium n'est JAMAIS lancé directement par l'agent. Il ne
# tourne que via le mode `run_browser` du helper vibed-tool — service systemd transitoire
# durci (ToolClass::Browser, ADR-019/022) : profil ÉPHÉMÈRE sans identifiants, egress au
# plancher IPAddressDeny=any (seule l'IP du proxy CONNECT dédié ouverte), pilotage CDP par
# PIPE (jamais un port TCP), `--no-sandbox`/`--remote-debugging-port` interdits au niveau
# argv (le helper refuse de les émettre). La simple PRÉSENCE du binaire n'ouvre aucune
# capacité nouvelle hors ce chemin gouverné — même modèle que la trousse sécurité (1d-bis)
# et les outils SaaS (1d-ter) : shippés dans le shell, mais l'invocation par l'IA passe par
# le tiering vibed. Le module SELinux de confinement de l'exécution est un incrément
# séparé (le durcissement du chemin run_browser, pas de la présence du binaire).
#
# NON épinglé à un NVRA exact, délibérément : chromium bouge très vite et Fedora retire
# les vieux NVRA des dépôts (un pin casserait les rebuilds, comme les COPR de la couche 1e).
# Le NEVRA réellement shippé est enregistré dans /usr/share/vibeos/packages-nevra.txt
# (couche 8), diffable entre releases. install_weak_deps=False garde l'image lean.
RUN dnf -y install --setopt=install_weak_deps=False \
        chromium-headless \
    && dnf clean all

# =============================================================================
# 2. VSCodium — community rpm repository (paulcarroty)
#    LICENSING: official VS Code binaries are proprietary and NOT redistributable
#    in an ISO (see docs/ECOSYSTEM.md). VSCodium is the MIT build of the same
#    codebase, wired to the Open VSX marketplace (where Cline/Continue publish).
#    The .repo file still ships in /etc so a rebuild can update codium — but
#    DISABLED, like the COPRs above: a deployed system never trusts a third-party
#    repo at runtime, and `--enablerepo=vscodium` turns it on only for this
#    transaction. gpgcheck stays enforced end-to-end.
#    (An enabled repo with gpgkey=file:// also BREAKS the ISO build — see the
#    long note on the mise repo above. Do not re-enable it.)
#
#    The signing key is imported from the PINNED copy on disk (see the COPY in
#    §1e-bis and os/keys/README.md), and gpgkey= points at that local path. It
#    used to be `rpm --import <gitlab raw url>` with gpgkey= on the same URL —
#    trust-on-first-use on every build, with nothing to notice a swapped key.
# =============================================================================
RUN set -eux \
    && rpmkeys --import /etc/pki/rpm-gpg/RPM-GPG-KEY-vscodium \
    && printf '%s\n' \
        '[vscodium]' \
        'name=VSCodium' \
        'baseurl=https://download.vscodium.com/rpms/' \
        'enabled=0' \
        'gpgcheck=1' \
        'repo_gpgcheck=1' \
        'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-vscodium' \
        'metadata_expire=1h' \
        > /etc/yum.repos.d/vscodium.repo \
    && dnf -y --enablerepo=vscodium install codium \
    && dnf clean all

# =============================================================================
# 3. NVIDIA proprietary driver + CUDA (amd64 ONLY — reference PC has an
#    RTX 3070 Ti, see docs/HARDWARE.md)
#
#    Technique: RPM Fusion akmod-nvidia + `akmods --force` at IMAGE BUILD time
#    (the Bazzite/Universal Blue pattern). The kernel module is compiled once
#    here against the exact kernel shipped in the image and becomes immutable
#    image content — nothing is ever compiled on user machines.
#
#    Honest limits (v0.1):
#      * The kmod is NOT signed for Secure Boot. With Secure Boot enabled the
#        module will not load; MOK signing of our kmods is Phase 4
#        (docs/HARDWARE.md, ROADMAP.md). Test with Secure Boot off until then.
#      * arm64 images get no NVIDIA layer at all (no supported hardware —
#        docs/HARDWARE.md).
#    Skipped when TARGETARCH != amd64 or NVIDIA_ENABLED != 1.
#
#    tsflags=noscripts sur akmod-nvidia SEUL — pas du confort, un bug amont :
#
#    kmodtool bake dans le %post de TOUT akmod un appel à `akmods-ostree-post`,
#    sans `|| :`. Ce helper appelle `akmodsbuild` DIRECTEMENT en root, là où
#    `akmods` passe par `runuser -u akmods`. Or `akmodsbuild` refuse de tourner
#    en root — via un proxy, `[[ -w /var ]]`. Le helper assume :
#      « This builds as root, but this is pretty safe because its happening in
#        the ostree %post sandbox. »
#    Vrai sous `rpm-ostree compose` (/var non inscriptible) ; FAUX sous buildah,
#    où root écrit /var. => RHBZ #2459819, closed insufficient_data. Bazzite a
#    le même (ublue-os/bazzite#5106). akmodsbuild est byte-pour-byte identique
#    de f42 à f44 : akmods n'a rien changé.
#
#    Il échouait donc DÉJÀ sur f42 : le même « ERROR: Not to be used as root »
#    est dans les logs des builds f42 qui ont livré des ISO. Ce qui a changé,
#    c'est dnf5 : f42 marquait « Non-critical error » et poursuivait, f44 fait
#    échouer toute la transaction RPM.
#
#    Le scriptlet est de toute façon REDONDANT ici : c'est l'`akmods --force`
#    ci-dessous qui construit le module (chemin `runuser`, celui qui marche —
#    et celui qu'ublue-os/akmods utilise toujours en 2026). Prouvé par les
#    builds f42, dont la garde `find nvidia*.ko` passait. On ne perd rien : on
#    cesse d'exiger qu'un scriptlet cassé réussisse. La garde `find` reste le
#    vrai contrôle — pas de module, build rouge.
#
#    Stubber /usr/sbin/akmods-ostree-post (l'autre correctif possible) est
#    écarté : ça livrerait un fichier appartenant au RPM `akmods` modifié, que
#    `rpm -Va` signalerait comme altéré — inacceptable dans une image qu'on
#    présente comme immuable et vérifiable. `noscripts` n'altère aucun fichier.
#    Transaction séparée : tsflags s'applique à TOUTE la transaction, les autres
#    paquets gardent leurs scriptlets.
#
#    kernel-devel via koji en repli : akmod DOIT builder contre le kernel-devel
#    EXACT du kernel du base. Les dépôts stables LAGGENT derrière un base
#    fraîchement bumpé — un bump de digest peut tirer un kernel dont le
#    kernel-devel n'est pas encore miroité (« No match for argument:
#    kernel-devel-<ver> »). Koji a tout build par NVRA : on tente le dépôt, puis
#    on retombe sur koji. Sans ça, tout bump vers un base à kernel plus récent
#    casse l'étage NVIDIA (constaté 2026-07-20 : base 4ff9e301 = kernel 7.1.4-200,
#    dépôts à 7.1.3-201, kernel-devel-7.1.4-200 présent sur koji mais pas miroité).
# =============================================================================
RUN set -eu; \
    if [ "${TARGETARCH}" != "amd64" ] || [ "${NVIDIA_ENABLED}" != "1" ]; then \
        echo "NVIDIA layer skipped (TARGETARCH=${TARGETARCH}, NVIDIA_ENABLED=${NVIDIA_ENABLED})"; \
        exit 0; \
    fi; \
    KVER="$(rpm -q kernel --qf '%{VERSION}\n' | tail -n 1)"; \
    KREL="$(rpm -q kernel --qf '%{RELEASE}\n' | tail -n 1)"; \
    KARCH="$(rpm -q kernel --qf '%{ARCH}\n' | tail -n 1)"; \
    KERNEL_VERSION="${KVER}-${KREL}.${KARCH}"; \
    echo "Building NVIDIA kmod for kernel ${KERNEL_VERSION}"; \
    dnf -y install \
        "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-44.noarch.rpm" \
        "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-44.noarch.rpm"; \
    dnf -y install --setopt=install_weak_deps=False \
        --setopt=tsflags=noscripts \
        akmod-nvidia; \
    if ! dnf -y install --setopt=install_weak_deps=False "kernel-devel-${KERNEL_VERSION}"; then \
        echo "kernel-devel ${KERNEL_VERSION} not in repos (mirror lag) — fetching from koji"; \
        dnf -y install --setopt=install_weak_deps=False \
            "https://kojipkgs.fedoraproject.org/packages/kernel/${KVER}/${KREL}/${KARCH}/kernel-devel-${KVER}-${KREL}.${KARCH}.rpm"; \
    fi; \
    dnf -y install --setopt=install_weak_deps=False xorg-x11-drv-nvidia-cuda; \
    akmods --force --kernels "${KERNEL_VERSION}" --kmod nvidia; \
    find "/usr/lib/modules/${KERNEL_VERSION}" -name 'nvidia*.ko*' | grep -q . \
        || { echo "FATAL: NVIDIA kmod was not built/installed"; exit 1; }; \
    dnf clean all

# =============================================================================
# 4. ollama — local LLM runtime (offline-capable half of the hybrid agent
#    runtime)
#
#    METHOD (chosen deliberately for an OSTree image): extract the official
#    release archive straight into /usr.
#      * The upstream install.sh is WRONG for us: it installs to /usr/local
#        (a symlink into /var on OSTree — content would be dropped from the
#        image) and mutates the system at install time (creates users,
#        enables units), which must not happen inside an image build.
#      * The archive layout (bin/ollama + lib/ollama/*) maps 1:1 onto /usr,
#        so the binary and its bundled runtime libraries become immutable,
#        signed image content.
#    Supply chain: version pinned + sha256 verified BEFORE extraction.
#    Checksums come from the official sha256sum.txt asset of the GitHub
#    release v0.31.1 (upstream ships .tar.zst archives; verified 2026-07-03).
#    Models are runtime state and live under the user's home or
#    /var/lib/ollama — never in the image.
# =============================================================================
ARG OLLAMA_VERSION=0.31.1
ARG OLLAMA_SHA256_AMD64=d297381efc136451f6fabb9dd644a67f70fe51c16815a0c4a95ff0e327a3afb4
ARG OLLAMA_SHA256_ARM64=47c82a67e59e060a735d1cb50a2acf020126a3a4be3f6847d5b58b7dd59620b6
RUN set -eu; \
    case "${TARGETARCH}" in \
        amd64) OLLAMA_SHA256="${OLLAMA_SHA256_AMD64}" ;; \
        arm64) OLLAMA_SHA256="${OLLAMA_SHA256_ARM64}" ;; \
        *) echo "FATAL: unsupported TARGETARCH '${TARGETARCH}'"; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/ollama.tar.zst \
        "https://github.com/ollama/ollama/releases/download/v${OLLAMA_VERSION}/ollama-linux-${TARGETARCH}.tar.zst"; \
    echo "${OLLAMA_SHA256}  /tmp/ollama.tar.zst" | sha256sum -c -; \
    tar --zstd -xf /tmp/ollama.tar.zst -C /usr; \
    rm -f /tmp/ollama.tar.zst; \
    /usr/bin/ollama --version

# =============================================================================
# 5. AI CLIs via npm — versions PINNED (supply chain)
#    npm's default global prefix on Fedora is /usr/local — a symlink into
#    /var on OSTree, i.e. NOT part of the image. Force --prefix=/usr so the
#    CLIs land in /usr/lib/node_modules with their launchers in /usr/bin.
#    HOME/npm_config_cache are forced to /tmp: on OSTree images /root is a
#    symlink to var/roothome (absent at build time), so npm's default cache
#    at /root/.npm fails with ENOTDIR. Keeping the cache in /tmp also keeps
#    it out of the image entirely.
#    Shipped CLIs: Claude Code, Claude Agent SDK, Gemini CLI, Codex, opencode
#    (see docs/ARCHITECTURE.md §4.4, ADR-006 and docs/ECOSYSTEM.md).
#    opencode (sst/opencode, MIT): multi-provider terminal agent, fully local
#    via ollama — the curated default addition to the shipped CLIs.
#    SUPPLY CHAIN (audit decision): --ignore-scripts — no npm lifecycle script
#    (postinstall & co, a classic exfiltration/backdoor vector) executes at
#    build time. TWO deliberate, scoped exceptions, re-run via a targeted
#    `npm rebuild` (every other package's scripts stay ignored) — both caught
#    by the verification layer below on 2026-07-08, exactly as designed:
#      * @anthropic-ai/claude-code: postinstall installs the first-party
#        native binary ("claude native binary not installed" without it);
#      * opencode-ai: postinstall wires the platform binary shipped in its
#        own optionalDependencies ("postinstall script was not run" without).
#    The verification layer proves each CLI works; if a future version starts
#    requiring its scripts, the BUILD fails there and any new exception is
#    made deliberately, here, in review.
# =============================================================================
RUN HOME=/tmp npm_config_cache=/tmp/.npm-cache \
        npm install -g --prefix=/usr --ignore-scripts \
        @anthropic-ai/claude-code@2.1.199 \
        @anthropic-ai/claude-agent-sdk@0.3.199 \
        @google/gemini-cli@0.49.0 \
        @openai/codex@0.142.5 \
        opencode-ai@1.17.13 \
    && HOME=/tmp npm_config_cache=/tmp/.npm-cache \
        npm rebuild -g --prefix=/usr --foreground-scripts \
        @anthropic-ai/claude-code \
        opencode-ai \
    && rm -rf /tmp/.npm-cache

# --- 5bis. Prove the CLIs run without their npm lifecycle scripts -------------
# Every shipped CLI must answer --version in the image being built (this is
# also a Phase 1 exit criterion, ROADMAP.md). HOME=/tmp: /root is a dangling
# symlink at build time (OSTree), and some CLIs write state on first run.
RUN HOME=/tmp claude --version \
    && HOME=/tmp gemini --version \
    && HOME=/tmp codex --version \
    && HOME=/tmp opencode --version

# =============================================================================
# 6. aider — NOT shipped by default (optional user install)
#    aider-chat requires Python <3.13, but the Kinoite base ships a newer
#    Python, so it cannot be layered into the image. The ECOSYSTEM curation already
#    flagged aider as declining and picked opencode (above) as the default
#    terminal agent. Users who want aider install it in an isolated Python 3.12
#    with uv, without touching the immutable OS:
#        uvx --python 3.12 aider-chat        # ephemeral
#        uv tool install --python 3.12 aider-chat   # persistent, in ~/.local
#    See docs/ECOSYSTEM.md.
# =============================================================================

# =============================================================================
# 7. VibeOS overlay — systemd units, presets, sysusers, image identity,
#    policies, genesis
#    os/rootfs/ mirrors the image filesystem and is copied verbatim onto /.
#    Units are enabled via /usr/lib/systemd/system-preset/50-vibeos.preset
#    (shipped by this COPY) rather than `systemctl enable`: systemd applies
#    presets automatically on first boot (uninitialized /etc/machine-id),
#    which is the correct mechanism for image-based systems and keeps the
#    build free of side effects in /etc. The sysusers.d fragment creates the
#    vibed user and the vibeos-agents group on first boot.
# =============================================================================
# Guard: os/rootfs ships /etc/xdg/kdeglobals (the system-wide Global Theme
# pointer). The pinned Kinoite base does not ship that file today; if a future
# base starts shipping one, fail the build so the two files are merged
# deliberately instead of silently clobbered by the COPY below.
RUN test ! -e /etc/xdg/kdeglobals
COPY os/rootfs/ /

# --- Policy engine defaults ---------------------------------------------------
# Source of truth lives in security/policy.d/ (owned by the security
# subsystem). Installed to /etc so local admins can override via the OSTree
# 3-way /etc merge. vibed loads *.toml from this directory in lexicographic
# order — first matching rule wins — and FAILS CLOSED (refuses to serve) on
# any invalid file.
COPY security/policy.d/*.toml /etc/vibeos/policy.d/

# --- Genesis: first-boot memory creation script ------------------------------
# Source of truth lives in memory/genesis.sh (owned by the memory subsystem).
# vibeos-genesis.service (shipped above) runs it once, guarded by
# ConditionPathExists=!/var/lib/vibeos/memory/.initialized.
# v0.1: the script creates the memory directory layout in CLEAR TEXT (no
# cryptsetup/mkfs/mount); LUKS + amnesic tmpfs are Phase 3 (docs/MEMORY.md).
COPY --chmod=0755 memory/genesis.sh /usr/libexec/vibeos/genesis.sh

# --- Desktop identity: VibeOS Dark theme assets ------------------------------
# The design system lives in docs/DESIGN-SYSTEM.md. PHASE 2 STATUS: the Global
# Theme org.vibeos.dark is now the SYSTEM DEFAULT — a one-line pointer in
# /etc/xdg/kdeglobals (shipped by the os/rootfs COPY above; KConfig cascade,
# users override freely in ~/.config) — and the Quickshell HUD is autostarted
# per-user (/etc/skel/.config/autostart/vibeos-hud.desktop -> /usr/bin/vibeos-hud).
#   * color scheme   -> default via the Global Theme defaults
#   * look-and-feel  -> DEFAULT (pointer in /etc/xdg/kdeglobals) — Phase 2 done
#   * Kvantum        -> engine installed (layer 1g); default widget style
#   * Quickshell QML -> autostarted HUD; data still mocked ("vibed hors ligne")
#                       until the QML socket wiring lands (Phase 2 remainder)
#   * wallpapers     -> four Plasma wallpaper packages; "VibeOS" is the desktop
#                       out-of-box default (Global Theme defaults: [Wallpaper]
#                       Image=VibeOS), "VibeOSVerou" is the lock-screen default
#                       (kscreenlockerrc), Genesis/Void stay in the picker
#   * SDDM/Plymouth  -> present; switched on at branding (Phase 5). The Plymouth
#                       theme's script/label modules ARE installed (layer 1g), so
#                       "present" now means renderable — it used to mean "copied,
#                       but its module was missing from the image".
COPY desktop/theme/vibeos-dark.colors /usr/share/color-schemes/VibeOSDark.colors
COPY desktop/look-and-feel/org.vibeos.dark /usr/share/plasma/look-and-feel/org.vibeos.dark
COPY desktop/wallpapers/VibeOS /usr/share/wallpapers/VibeOS
COPY desktop/wallpapers/VibeOSDark /usr/share/wallpapers/VibeOSDark
COPY desktop/wallpapers/VibeOSVoid /usr/share/wallpapers/VibeOSVoid
COPY desktop/wallpapers/VibeOSVerou /usr/share/wallpapers/VibeOSVerou
COPY desktop/sddm/vibeos /usr/share/sddm/themes/vibeos
COPY desktop/plymouth/vibeos /usr/share/plymouth/themes/vibeos
COPY desktop/kvantum/VibeOSDark /usr/share/Kvantum/VibeOSDark
COPY desktop/quickshell /usr/share/vibeos/quickshell

# --- PHASE 2: install vibed from the builder stage ---------------------------
# Installing the binary satisfies vibed.service's ConditionPathExists guard, so
# the daemon starts at boot: it creates /run/vibed (RuntimeDirectory), listens
# on /run/vibed/mcp.sock (root:vibeos-agents 0660), loads /etc/vibeos/policy.d/
# (fail-closed on invalid policy) and writes the audit log under StateDirectory
# /var/lib/vibeos. See vibed/README.md and docs/ARCHITECTURE.md.
COPY --from=vibed-builder /src/vibed/target/release/vibed /usr/bin/vibed
# vibectl — read-only operator CLI (memory status, audit-chain verification).
COPY --from=vibed-builder /src/vibed/target/release/vibectl /usr/bin/vibectl

# --- PHASE 2: install quickshell from the builder stage -----------------------
# bin/qs + bin/quickshell, the Quickshell QML modules (lib64/qt6/qml) and the
# desktop entry/icon land in /usr as immutable image content. The --version
# run proves the Qt private-ABI contract (see the quickshell-builder header):
# a mismatch with the base image's Qt aborts the build here, never on user
# machines. Runtime deps (kvantum aside): jemalloc + qt6-qtsvg, layer 1g.
COPY --from=quickshell-builder /out/usr/ /usr/
RUN QT_QPA_PLATFORM=offscreen /usr/bin/quickshell --version

# --- PHASE 2ter: install the VibeOS-for-Zed extension bundle (gated) ----------
# From the selector stage: the single bundled ESM when WITH_ZED_AGENT=1, or a
# NOT-INSTALLED marker otherwise. Lands under /usr (immutable image content);
# never node_modules or TS sources. Wiring it into Zed's settings.json (couche
# 0/1) follows once the live E2E validates the bundle (ADR-015 §6).
COPY --from=zed-agent-selected /out/zed-agent/ /usr/lib/vibeos/zed-agent/

# =============================================================================
# 8. Finalize: NEVRA manifest, scrub machine-local state, validate the image
#    /var must ship empty in a bootc image (it is deploy-time machine state);
#    dnf/npm/pip/akmods leave caches and logs behind. /run and /tmp are
#    runtime-only tmpfs and must ship empty too (npm's node-gyp cache landed in
#    /tmp/.cache because we set HOME=/tmp for the CLI install). `bootc container
#    lint` warns on any content in /run and /tmp. Keep this as the FINAL step.
# =============================================================================
# --- Supply chain: exact RPM inventory of the shipped image -------------------
# COPR/vendor packages are deliberately not version-pinned at install time
# (old NEVRAs vanish from those repos and would break rebuilds), so the shipped
# set is RECORDED instead: one NEVRA per line, diffable between releases and
# usable to re-audit exactly what a given image contains.
RUN rpm -qa --qf '%{NEVRA}\n' | sort > /usr/share/vibeos/packages-nevra.txt \
    && wc -l /usr/share/vibeos/packages-nevra.txt
# Note: do NOT wipe all of /run — podman bind-mounts /run/systemd/resolve for
# build-time DNS and it is busy. Only the dnf cruft under /run needs removing.
# The post-scrub `claude`/`opencode` --version runs prove the binaries wired
# by the scoped `npm rebuild` (layer 5) live in IMAGE content (/usr), not in
# a build-time $HOME that this scrub just deleted — fresh empty HOME, exactly
# like a user's first run. Their /tmp droppings are wiped again before lint.
RUN rm -rf /var/cache/* /var/log/* /var/lib/dnf /var/tmp/* /root/.cache \
             /tmp/* /tmp/.[!.]* /run/dnf \
    && HOME=/tmp /usr/bin/claude --version \
    && HOME=/tmp /usr/bin/opencode --version \
    && rm -rf /tmp/* /tmp/.[!.]* \
    && bootc container lint
