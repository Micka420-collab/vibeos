// ~/.config/zellij/layouts/vibe.kdl — the VibeOS signature layout
// « agent + lazygit + logs » — open it from your project directory with
// `vibe` (fish abbr) or `zellij --layout vibe`.
//
//   ┌────────────────────────────┬────────────────────┐
//   │                            │      lazygit       │
//   │         agent CLI          ├────────────────────┤
//   │ (claude / opencode / ...)  │  vibed audit log   │
//   └────────────────────────────┴────────────────────┘
//
// The vibed daemon ships in the image and starts at boot. Its audit journal
// (/var/lib/vibeos/audit/vibed.jsonl) is root-only BY DESIGN (agents must
// never read it), so the pane shows the daemon's live status and the sudo
// hint instead — and tails the journal when it IS readable (e.g. zellij run
// from a root session during forensics).

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="vibe" focus=true {
        pane split_direction="vertical" {

            // Main stage: run your agent CLI here
            // (claude, opencode, aider, gemini, codex — or plain fish).
            pane name="agent" size="62%" focus=true

            pane split_direction="horizontal" size="38%" {

                // Review & commit what the agents produce.
                // Guarded: falls back to a plain shell if lazygit is missing.
                pane name="git" size="55%" command="bash" {
                    args "-c" "if command -v lazygit >/dev/null 2>&1; then exec lazygit; else echo; echo '  lazygit est introuvable dans cette session.'; echo '  Utilisez git directement dans ce pane.'; exec ${SHELL:-bash}; fi"
                }

                // vibed status pane — tails the audit journal when readable
                // (root session), otherwise shows the daemon's live state and
                // the sudo hint. Graceful when vibed is stopped.
                pane name="vibed" size="45%" command="bash" {
                    args "-c" "AUDIT=/var/lib/vibeos/audit/vibed.jsonl; while true; do clear; if [ -r $AUDIT ]; then echo '  ── journal d’audit vibed ──'; tail -n 40 -F $AUDIT; elif command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet vibed 2>/dev/null; then echo; echo '  [vibed actif] — MCP : /run/vibed/mcp.sock'; echo; echo '  Le journal d’audit est réservé à root (par conception) :'; echo '  sudo tail -f /var/lib/vibeos/audit/vibed.jsonl'; echo; echo '  Accès agents : groupe vibeos-agents (wheel enrôlé au boot).'; else echo; echo '  [vibed hors ligne]'; echo; echo '  systemctl status vibed   # diagnostic'; echo; echo '  Nouvelle tentative dans 15 s…'; fi; sleep 15; done"
                }
            }
        }
    }
}
