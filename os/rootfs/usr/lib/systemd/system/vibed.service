# vibed.service — VibeOS system AI daemon
#
# vibed (Rust/tokio) exposes OS control to AI agents through an MCP server
# (JSON-RPC 2.0) listening on the unix socket /run/vibed/mcp.sock. Every tool
# call is gated by the policy engine (/etc/vibeos/policy.d/*.toml, capability
# tiers T0..T3, first matching rule wins, absolute default-deny) and appended
# to the audit trail /var/lib/vibeos/audit/ (append-only JSONL, one file per
# UTC day, SHA-256 hash chain continuous across days, with caller identity;
# external anchoring TPM/Rekor + journald replication are Phase 4).
#
# Privileges — honest v0.1 status: vibed runs as ROOT (no User= below).
# The Phase 4 target is User=vibed (account already created by
# /usr/lib/sysusers.d/vibeos.conf) with an empty CapabilityBoundingSet=
# allow-list. Socket access control TODAY: vibed itself chgrps
# /run/vibed/mcp.sock to root:vibeos-agents mode 0660 at startup, so only
# members of the vibeos-agents group can reach the daemon.
#
# Phase 2 note: this unit ships BEFORE the binary exists. The Condition below
# makes systemd SKIP the unit (state "condition failed", not "failed") until
# /usr/bin/vibed is added to the image, so boot is never broken. No
# placeholder binary is ever shipped — a placeholder would defeat the guard.

[Unit]
Description=VibeOS system AI daemon (MCP server on /run/vibed/mcp.sock)
Documentation=https://github.com/Micka420-collab/vibeos
# Do not start (and do not fail) while the daemon is not shipped in the image.
ConditionPathExists=/usr/bin/vibed
# The memory subsystem must exist before agents can use it.
After=vibeos-genesis.service
# Cloud-backed agents (Claude API, ...) want the network; local ollama does not
# strictly need it, so this is a Wants, not a Requires.
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/vibed
Restart=on-failure
RestartSec=2s

# --- Runtime layout -----------------------------------------------------------
# /run/vibed        -> mcp.sock (wiped every boot). 0755 so members of
#                      vibeos-agents can traverse the directory; access
#                      control is enforced on the socket itself
#                      (root:vibeos-agents 0660, set by vibed at startup).
RuntimeDirectory=vibed
RuntimeDirectoryMode=0755
# /var/lib/vibeos   -> memory subsystem mountpoint + audit trail
#                      (/var/lib/vibeos/audit/vibed-<date>.jsonl); automatically
#                      writable even under ProtectSystem=strict.
StateDirectory=vibeos
StateDirectoryMode=0700
# /etc/vibeos       -> policy.d/*.toml
ConfigurationDirectory=vibeos
UMask=0077

# --- Sandboxing / hardening ----------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
# fs.write (T1) targets USER files: /home/** and /var/home/** only (on Fedora,
# /home is a symlink to /var/home). ProtectSystem=strict mounts everything
# read-only, so /var/home must be explicitly re-opened; ProtectHome=read-only
# would take precedence over ReadWritePaths and defeat fs.write — hence
# ProtectHome=no. Path containment is enforced by the policy engine plus the
# built-in hard denylist in vibed (audit trail, ~/.ssh, ~/.gnupg, policies...).
ProtectHome=no
ReadWritePaths=/var/home
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DevicePolicy=closed
# v0.1: deny-list of capabilities vibed must never hold, even as root. This is
# NOT least-privilege — root keeps broad capabilities. Phase 4 replaces this
# with User=vibed + an empty allow-list (CapabilityBoundingSet=) once the
# daemon's exact needs (systemd D-Bus, package management) are measured.
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_RAWIO CAP_SYS_BOOT CAP_SYS_TIME CAP_AUDIT_CONTROL

# --- seccomp -------------------------------------------------------------------
# @system-service is the reasonable baseline for a system daemon; the second
# deny-list line is defense in depth for groups that must never be reachable
# from an AI-facing control plane. Per-tool sandboxing (systemd-run transient
# units, per-class seccomp, Landlock) is Phase 3 — in v0.1 tools execute
# in-process, gated by policy + built-in denylist only.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @swap @reboot @obsolete @cpu-emulation @raw-io
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
