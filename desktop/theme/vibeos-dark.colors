#
# Palette (Catppuccin Mocha values, kept verbatim):
#   Base    #1e1e2e   Mantle  #181825   Crust    #11111b
#   Surface0 #313244  Surface1 #45475a  Surface2 #585b70
#   Overlay0 #6c7086  Overlay1 #7f849c  Overlay2 #9399b2
#   Text    #cdd6f4   Subtext1 #bac2de  Subtext0 #a6adc8
#   Mauve   #cba6f7 (VibeOS accent)     Blue     #89b4fa
#   Green   #a6e3a1   Peach   #fab387   Red      #f38ba8
#   Yellow  #f9e2af   Lavender #b4befe  Pink     #f5c2e7
#
# All values below are decimal "r,g,b" as required by KColorScheme.
# Install target (image build): /usr/share/color-schemes/VibeOSDark.colors

