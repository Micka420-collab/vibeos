# VibeOS — Plymouth boot splash (theme descriptor)
# =============================================================================
# Target (image build): /usr/share/plymouth/themes/vibeos/vibeos.plymouth
# Source: desktop/plymouth/vibeos/vibeos.plymouth (COPY-ed into the image).
# Status: ✅ ACTIVE (2026-07-23, at the maintainer's request). This IS the boot
# splash: os/Containerfile sets it default (plymouth-set-default-theme vibeos)
# AND regenerates the initramfs at image build so it renders before the root fs
# is mounted (the immutable-OS-specific step — see desktop/plymouth/README.md).
#
# Uses the "script" module: the whole splash is driven by vibeos.script, so no
# separate C plugin is needed and the animation stays fully readable/auditable.
# =============================================================================
[Plymouth Theme]
Name=VibeOS
Description=Dark Crust backdrop, a breathing luminous core and a slow mauve→blue signature spiral (the VibeOS galaxy).
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/vibeos
ScriptFile=/usr/share/plymouth/themes/vibeos/vibeos.script
